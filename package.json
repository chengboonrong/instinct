{
  "name": "instinct-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "vitest run",
    "typecheck": "tsc -b packages/core/tsconfig.json packages/hsm/tsconfig.json packages/blackboard/tsconfig.json && tsc -p packages/blackboard/tsconfig.type-tests.json"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.0.0"
  }
}
